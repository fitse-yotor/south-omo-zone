# South Omo Zone portal: copy to .env on the server and fill in the values marked ← .
APP_NAME="South Omo Zone"
APP_ENV=production
# ← php artisan key:generate
APP_KEY=
# never true on the live site
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
# ← your real address, with https
APP_URL=https://southomo.gov.et

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL / MariaDB database created in cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# ← e.g. cpaneluser_southomo
DB_DATABASE=
# ← e.g. cpaneluser_portal
DB_USERNAME=
# ←
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# shared hosting: no queue worker
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=southomo

# Email for contact-form notifications (cPanel → Email Accounts gives these settings).
# Leave MAIL_MAILER=log to only store messages in the admin inbox.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.southomo.gov.et
MAIL_PORT=465
MAIL_USERNAME=portal@southomo.gov.et
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="portal@southomo.gov.et"
MAIL_FROM_NAME="${APP_NAME}"

# Only for the first `php artisan db:seed`, then delete these two lines:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
